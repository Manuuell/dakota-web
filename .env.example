# Copia esto a .env y rellena con los valores del proyecto "dakota" de Firebase.
# .env está en .gitignore: la clave privada nunca va al repositorio.

# ---- Servidor: Admin SDK ----
# Los tres vienen del JSON de la cuenta de servicio
# (Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada).
FIREBASE_PROJECT_ID=dakota
FIREBASE_CLIENT_EMAIL=
# En una sola línea, con los saltos como \n literales y todo entre comillas.
FIREBASE_PRIVATE_KEY=""

# ---- Cliente: solo lo usa /pedir/cocina ----
# Vienen de Configuración del proyecto → Tus apps → app web → configuración SDK.
# Son públicas por diseño; lo que protege los datos son las reglas de Firestore.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=dakota.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=dakota

# ---- Desarrollo con el emulador ----
# Descomenta para trabajar sin tocar la base real (y sin necesitar credenciales):
#   firebase emulators:start --only firestore,auth
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
