---
// Campo de brasas ascendentes. Canvas 2D, ~120 partículas, mezcla aditiva.
// Se detiene fuera de pantalla y respeta prefers-reduced-motion.
const { density = 1, class: className = "" } = Astro.props;
---
<canvas class:list={["embers", className]} data-density={density} aria-hidden="true"></canvas>

<style>
  .embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 1;
  }
</style>

<script>
  class EmberField {
    constructor(canvas) {
      this.c = canvas;
      this.ctx = canvas.getContext("2d", { alpha: true });
      this.density = parseFloat(canvas.dataset.density || "1");
      this.parts = [];
      this.running = false;
      this.reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      this.resize();
      this.seed();
      this.observe();
      window.addEventListener("resize", () => this.resize(), { passive: true });
    }

    resize() {
      const r = this.c.getBoundingClientRect();
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.w = Math.max(1, r.width);
      this.h = Math.max(1, r.height);
      this.c.width = this.w * this.dpr;
      this.c.height = this.h * this.dpr;
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      const target = Math.round(Math.min(150, (this.w * this.h) / 9000) * this.density);
      while (this.parts.length < target) this.parts.push(this.make(true));
      this.parts.length = target;
    }

    make(scatter) {
      // Vida corta y arranque bajo: la brasa nace en el borde inferior y muere arriba.
      return {
        x: Math.random() * this.w,
        y: scatter ? Math.random() * this.h : this.h + Math.random() * 40,
        r: 0.6 + Math.random() * 2.2,
        vy: 0.18 + Math.random() * 0.65,
        drift: (Math.random() - 0.5) * 0.34,
        phase: Math.random() * Math.PI * 2,
        wobble: 0.4 + Math.random() * 1.1,
        life: 0,
        max: 190 + Math.random() * 240,
        heat: Math.random(),
      };
    }

    color(p, a) {
      // Del rojo profundo al núcleo dorado según el "calor" de la partícula.
      if (p.heat > 0.86) return `rgba(255,233,168,${a})`;
      if (p.heat > 0.55) return `rgba(255,179,71,${a})`;
      if (p.heat > 0.24) return `rgba(255,106,31,${a})`;
      return `rgba(194,26,18,${a})`;
    }

    seed() {
      if (this.reduced) this.paintStatic();
    }

    paintStatic() {
      const { ctx } = this;
      ctx.clearRect(0, 0, this.w, this.h);
      ctx.globalCompositeOperation = "lighter";
      for (const p of this.parts) {
        ctx.fillStyle = this.color(p, 0.4);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    frame = () => {
      if (!this.running) return;
      const { ctx } = this;
      ctx.clearRect(0, 0, this.w, this.h);
      ctx.globalCompositeOperation = "lighter";

      for (let i = 0; i < this.parts.length; i++) {
        const p = this.parts[i];
        p.life++;
        p.phase += 0.028;
        p.y -= p.vy;
        p.x += p.drift + Math.sin(p.phase) * p.wobble * 0.5;

        const t = p.life / p.max;
        if (t >= 1 || p.y < -20) {
          this.parts[i] = this.make(false);
          continue;
        }
        // Aparece rápido, se apaga lento — como una chispa real.
        const alpha = t < 0.12 ? t / 0.12 : Math.pow(1 - (t - 0.12) / 0.88, 1.6);
        const rr = p.r * (1 - t * 0.45);

        ctx.fillStyle = this.color(p, alpha * 0.95);
        ctx.beginPath();
        ctx.arc(p.x, p.y, rr, 0, Math.PI * 2);
        ctx.fill();

        // Halo suave sobre las brasas más calientes
        if (p.heat > 0.55) {
          ctx.fillStyle = this.color(p, alpha * 0.14);
          ctx.beginPath();
          ctx.arc(p.x, p.y, rr * 4.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      this.raf = requestAnimationFrame(this.frame);
    };

    start() {
      if (this.reduced || this.running) return;
      this.running = true;
      this.raf = requestAnimationFrame(this.frame);
    }
    stop() {
      this.running = false;
      if (this.raf) cancelAnimationFrame(this.raf);
    }

    observe() {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? this.start() : this.stop())),
        { threshold: 0 }
      );
      io.observe(this.c);
      document.addEventListener("visibilitychange", () =>
        document.hidden ? this.stop() : this.start()
      );
    }
  }

  document.querySelectorAll(".embers").forEach((c) => new EmberField(c));
</script>
