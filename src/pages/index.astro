</style>

<script>
  // Resalta la categoría visible en la barra de pestañas
  const tabs = document.querySelectorAll(".menu__tabs a");
  const cats = document.querySelectorAll(".cat");
  if (tabs.length && cats.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = e.target.id.replace("cat-", "");
          tabs.forEach((t) => t.classList.toggle("is-active", t.dataset.cat === id));
        });
      },
      { rootMargin: "-140px 0px -65% 0px" }
    );
    cats.forEach((c) => spy.observe(c));
  }
</script>
