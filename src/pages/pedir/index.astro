---
import Pedido from "../../layouts/Pedido.astro";
import Picture from "../../components/Picture.astro";
import menu from "../../data/menu.json";
import { mesaActual } from "../../lib/mesa";
import { cop } from "../../lib/carta";

export const prerender = false;

const mesa = await mesaActual(Astro.cookies);
const qrInvalido = Astro.url.searchParams.get("qr") === "invalido";
const WHATSAPP = "573189585000";

// Los precios se repiten en el cliente solo para pintar el total del carrito
// mientras se toca. El que manda sigue siendo el del servidor: /pedir/api/pedido
// los vuelve a calcular desde menu.json y descarta lo que llegue del navegador.
const precios = Object.fromEntries(
  menu.categorias.flatMap((c) =>
    c.productos.map((p) => [
      p.id,
      {
        n: p.nombre,
        p: p.precio,
        pp: p.precioPapa ?? null,
        ad: Object.fromEntries((c.adiciones ?? []).map((a) => [a.id, a.precio])),
      },
    ])
  )
);
---

<Pedido title="Carta — Dakota Smokehouse" mesa={mesa?.etiqueta}>
  <header class="intro">
    <p class="eyebrow">{mesa ? `Estás en la mesa ${mesa.etiqueta}` : "Alto Bosque · Cartagena"}</p>
    <h1 class="intro__t">La carta</h1>
    <p class="intro__d">
      {mesa
        ? "Añade lo que quieras y mándalo a la cocina. Puedes seguir pidiendo después: todo se suma a la misma cuenta."
        : "Premium smokehouse. Carne sellada al carbón en horno Josper, pan pretzel artesanal y salsas de la casa."}
    </p>
  </header>

  {!mesa && (
    <aside class="aviso">
      <p class="aviso__t">{qrInvalido ? "Ese código ya no está activo" : "No estás en una mesa"}</p>
      <p class="aviso__d">
        Escanea el QR de tu mesa para pedir desde aquí. Mientras tanto puedes
        hacer tu pedido por WhatsApp.
      </p>
      <a class="btn" href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener">
        Pedir por WhatsApp
      </a>
    </aside>
  )}

  <nav class="cats" aria-label="Categorías">
    {menu.categorias.map((c) => <a href={`#c-${c.id}`}>{c.nombre}</a>)}
  </nav>

  {menu.categorias.map((c, ci) => (
    <section class:list={["cat", ci % 2 === 1 && "cat--alt"]} id={`c-${c.id}`}>
      <div class="shell">
        <header class:list={["cat__head", c.foto && "cat__head--foto"]}>
          <div>
            <p class="script cat__script">{c.script}</p>
            <h2 class="cat__title"><span class="cat__title-fill">{c.nombre}</span></h2>
          </div>
          {c.foto && (
            <div class:list={["cat__foto", `cat__foto--${c.foto.fondo}`]}>
              <Picture
                src={c.foto.src}
                alt={c.foto.alt}
                widths={c.foto.widths}
                ratio={c.foto.ratio}
                sizes="(max-width: 760px) 42vw, 30vw"
              />
            </div>
          )}
        </header>

        <ul class="items">
          {c.productos.map((p, i) => (
            <li class="item">
              <span class="item__idx num">{String(i + 1).padStart(2, "0")}</span>

              <div class="item__body">
                <h3 class="item__name">
                  {p.nombre}
                  {p.estrella && <em class="flag flag--star">La reina</em>}
                  {p.chef && <em class="flag flag--chef">Del chef</em>}
                  {p.picante && <em class="flag flag--hot">Picante</em>}
                  {p.doble && <em class="flag">Doble carne</em>}
                </h3>
                {p.desc && <p class="item__desc">{p.desc}</p>}
                {p.nota && <p class="item__nota">{p.nota}</p>}

                {mesa ? (
                  <div class="vars" data-prod={p.id}>
                    {c.adiciones && (
                      <ul class="adis">
                        {c.adiciones.map((a) => (
                          <li>
                            <button type="button" class="adi" data-adi={a.id} aria-pressed="false">
                              {a.nombre}
                              <b class="num">+{cop(a.precio)}</b>
                            </button>
                          </li>
                        ))}
                      </ul>
                    )}

                    <div class="var" data-id={p.id} data-papa="0">
                      {p.precioPapa && <i class="var__et">Sin papa</i>}
                      <b class="num var__p">{cop(p.precio)}</b>
                      <button class="add" type="button" data-accion="mas">Añadir</button>
                      <div class="paso" hidden>
                        <button type="button" data-accion="menos" aria-label={`Quitar un ${p.nombre}`}>−</button>
                        <span class="num" data-n>0</span>
                        <button type="button" data-accion="mas" aria-label={`Añadir un ${p.nombre}`}>+</button>
                      </div>
                    </div>

                    {p.precioPapa && (
                      <div class="var" data-id={p.id} data-papa="1">
                        <i class="var__et">Con papa</i>
                        <b class="num var__p">{cop(p.precioPapa)}</b>
                        <button class="add" type="button" data-accion="mas">Añadir</button>
                        <div class="paso" hidden>
                          <button type="button" data-accion="menos" aria-label={`Quitar un ${p.nombre} con papa`}>−</button>
                          <span class="num" data-n>0</span>
                          <button type="button" data-accion="mas" aria-label={`Añadir un ${p.nombre} con papa`}>+</button>
                        </div>
                      </div>
                    )}
                  </div>
                ) : (
                  <div class="vars vars--wa">
                    <b class="num var__p">{cop(p.precio)}</b>
                    {p.precioPapa && <b class="num var__p">{cop(p.precioPapa)} con papa</b>}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="salsas">
    <div class="shell salsas__in">
      <div>
        <p class="script cat__script">de la casa</p>
        <h2 class="salsas__t">Salsas artesanales</h2>
        <p class="salsas__d">
          Todas se hacen acá. Tártara, rosada ahumada, gaucha, chimichurri,
          mayochipotle, suero de chipotle, BBQ de guayaba, hawaiana, bacon jam,
          dulce de piña y el dip de jalapeño.
        </p>
        <p class="salsas__n num">Van incluidas con tu pedido. Pide la que quieras.</p>
      </div>
      <div class="salsas__foto">
        <Picture
          src="/img/cat/salsas"
          alt="Tres salsas artesanales de la casa servidas en cuencos"
          widths={[400, 800]}
          ratio="2 / 1"
          sizes="(max-width: 760px) 88vw, 42vw"
        />
      </div>
    </div>
  </section>

  {mesa && (
    <>
      <div class="hueco" aria-hidden="true"></div>
      <a class="carrito" href="/pedir/confirmar" hidden>
        <span class="carrito__n"><b data-items>0</b> ítems</span>
        <span class="carrito__t num" data-total>$0</span>
        <span class="carrito__ir">Ver pedido →</span>
      </a>
    </>
  )}

  <script id="precios" type="application/json" set:html={JSON.stringify(precios)} />
</Pedido>

<style>
  .intro { padding: clamp(30px, 7vw, 54px) var(--gutter) clamp(20px, 4vw, 30px); max-width: 640px; }
  .intro__t { font-size: clamp(40px, 11vw, 76px); color: var(--dkt-cream); margin: 12px 0 0; }
  .intro__d { margin: 16px 0 0; font-size: 15px; line-height: 1.55; color: var(--ink-dim); max-width: 46ch; }

  .aviso {
    margin: 0 var(--gutter) 10px;
    padding: 22px;
    border: 1px solid var(--hairline);
    background: var(--surface-2);
  }
  .aviso__t {
    margin: 0 0 8px;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 19px;
    color: var(--dkt-cream);
  }
  .aviso__d { margin: 0 0 18px; font-size: 14.5px; color: var(--ink-dim); max-width: 46ch; }

  /* ---------- navegación de categorías ---------- */
  .cats {
    position: sticky;
    top: 58px;
    z-index: 40;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 12px var(--gutter);
    background: linear-gradient(var(--surface) 78%, rgba(21,21,22,.92));
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
    scrollbar-width: none;
  }
  .cats::-webkit-scrollbar { display: none; }
  .cats a {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 9px 14px;
    color: var(--ink-dim);
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: color .3s ease, background .3s ease, box-shadow .3s ease;
  }
  .cats a:hover, .cats a.is-active {
    color: var(--dkt-cream);
    background: var(--dkt-red);
    box-shadow: inset 0 0 0 1px var(--dkt-red);
  }

  /* ---------- categoría ---------- */
  .cat { padding: clamp(38px, 7vw, 76px) 0; scroll-margin-top: 116px; }
  .cat--alt { background: var(--surface-2); }
  .shell { width: 100%; max-width: 1100px; margin-inline: auto; padding-inline: var(--gutter); }

  .cat__head { margin-bottom: clamp(22px, 4vw, 38px); }
  /* minmax(0,…) y no 1fr: un `1fr` nunca baja de min-content, y un título de
     una sola palabra en Archivo Black es más ancho que su columna en móvil,
     así que empujaba la foto fuera de la pantalla. */
  .cat__head--foto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(110px, 34%);
    gap: clamp(16px, 4vw, 44px);
    align-items: center;
  }
  .cat__script { margin: 0 0 2px; }
  .cat__title { font-size: clamp(30px, 8.5vw, 88px); line-height: .9; }
  /* la trama diagonal dentro de la letra — la firma del menú impreso */
  .cat__title-fill {
    background-image: repeating-linear-gradient(45deg, var(--dkt-cream) 0 3px, transparent 3px 10px);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--dkt-cream);
    paint-order: stroke fill;
  }
  .cat__foto :global(.pic) { background: transparent; }
  /* recortes con alfa: el producto va suelto sobre el fondo, con sombra de brasa */
  .cat__foto--alfa :global(.pic img) {
    object-fit: contain;
    filter: drop-shadow(0 18px 32px rgba(0,0,0,.6)) drop-shadow(0 0 26px rgba(255,106,31,.2));
  }
  .cat__foto--foto :global(.pic) { background: var(--surface-3); }

  /* ---------- platos ---------- */
  .items { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  .item {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 4px 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .item__idx { font-size: 11.5px; color: var(--ink-faint); padding-top: 6px; }
  .item__name {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(18px, 4.6vw, 26px);
    letter-spacing: -.02em;
    line-height: 1.05;
    margin: 0 0 8px;
    color: var(--dkt-cream);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
  }
  .item__desc { margin: 0; max-width: 58ch; font-size: 13.5px; line-height: 1.55; color: var(--ink-dim); }
  .item__nota { margin: 8px 0 0; font-size: 12.5px; color: var(--ember-hot); font-family: var(--font-mono); }

  .flag {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
    padding: 4px 8px;
    color: var(--ink-dim);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .flag--star { color: var(--dkt-char); background: var(--ember-hot); box-shadow: none; }
  .flag--hot { color: var(--dkt-cream); background: var(--dkt-red); box-shadow: none; }
  .flag--chef { color: var(--ember-hot); box-shadow: inset 0 0 0 1px var(--ember-mid); }

  /* ---------- añadir ---------- */
  .vars { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }

  .adis { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; flex-basis: 100%; }
  .adi {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 13px;
    min-height: 40px;
    background: transparent;
    border: 1px dashed var(--hairline);
    color: var(--ink-dim);
    font-family: var(--font-body);
    font-size: 12.5px;
    cursor: pointer;
  }
  .adi b { font-family: var(--font-mono); font-size: 11.5px; color: var(--ink-faint); }
  .adi[aria-pressed="true"] {
    border: 1px solid var(--ember-mid);
    color: var(--dkt-cream);
    background: rgba(255,106,31,.12);
  }
  .adi[aria-pressed="true"] b { color: var(--ember-hot); }

  .var {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px 7px 14px;
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .var__et {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .var__p { font-size: 15px; color: var(--dkt-cream); font-weight: 700; }
  .vars--wa { gap: 18px; }
  .vars--wa .var__p { color: var(--ink-dim); font-weight: 400; font-size: 14px; }

  .add {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 10px 15px;
    min-height: 44px;
    border: 0;
    background: var(--dkt-red);
    color: var(--dkt-cream);
    cursor: pointer;
    transition: filter .2s ease;
  }
  .add:hover { filter: brightness(1.12); }

  .paso { display: flex; align-items: center; gap: 4px; }
  .paso button {
    width: 44px; height: 44px;
    border: 0;
    background: var(--dkt-red);
    color: var(--dkt-cream);
    font-size: 20px; line-height: 1;
    cursor: pointer;
  }
  .paso span { min-width: 30px; text-align: center; font-size: 16px; font-weight: 700; color: var(--dkt-cream); }

  /* ---------- salsas ---------- */
  .salsas { padding: clamp(38px, 7vw, 70px) 0 clamp(50px, 8vw, 90px); }
  .salsas__in {
    display: grid;
    grid-template-columns: 1fr minmax(200px, 42%);
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
    border-top: 1px solid var(--hairline);
    padding-top: clamp(26px, 4vw, 40px);
  }
  .salsas__t {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(22px, 5vw, 34px);
    letter-spacing: -.02em;
    color: var(--dkt-cream);
    margin: 0 0 12px;
  }
  .salsas__d { margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-dim); max-width: 46ch; }
  .salsas__n {
    margin: 14px 0 0;
    font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--ember-hot);
  }
  .salsas__foto :global(.pic) { background: transparent; }
  .salsas__foto :global(.pic img) { object-fit: contain; filter: drop-shadow(0 16px 26px rgba(0,0,0,.55)); }

  @media (max-width: 760px) {
    .cat__head--foto { grid-template-columns: minmax(0, 1fr) 36%; align-items: end; }
    .salsas__in { grid-template-columns: 1fr; }
  }

  /* ---------- barra del carrito ---------- */
  .hueco { height: 96px; }
  .carrito {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px var(--gutter);
    background: var(--dkt-red);
    color: var(--dkt-cream);
    box-shadow: 0 -14px 34px -18px rgba(0,0,0,.9);
  }
  .carrito__n {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase;
  }
  .carrito__n b { font-size: 14px; }
  .carrito__t { margin-inline-start: auto; font-size: 18px; font-weight: 700; }
  .carrito__ir { font-size: 11.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
</style>

<script>
  const CLAVE = "dkt_carrito";
  const datos = document.getElementById("precios");
  const precios = datos ? JSON.parse(datos.textContent || "{}") : {};

  const leer = () => {
    try {
      const v = JSON.parse(localStorage.getItem(CLAVE) || "[]");
      return Array.isArray(v) ? v : [];
    } catch {
      return [];
    }
  };

  let carrito = leer().filter((l) => precios[l.id]);

  function precioUnidad(l) {
    const p = precios[l.id];
    const base = l.conPapa ? p.pp ?? p.p : p.p;
    return (l.adiciones ?? []).reduce((s, id) => s + (p.ad?.[id] ?? 0), base);
  }

  const guardar = () => {
    try {
      localStorage.setItem(CLAVE, JSON.stringify(carrito));
    } catch {
      /* modo privado: el carrito vive solo en memoria */
    }
  };

  // Una línea del carrito es un plato con sus extras: la misma Salchipapa con
  // quesudo y sin él son dos líneas distintas, porque cuestan distinto.
  const firma = (adiciones) => [...(adiciones ?? [])].sort().join(",");

  const adisElegidas = (el) =>
    [...el.closest(".vars").querySelectorAll('.adi[aria-pressed="true"]')].map((b) => b.dataset.adi);

  const buscar = (id, conPapa, adiciones) =>
    carrito.find(
      (l) => l.id === id && !!l.conPapa === conPapa && firma(l.adiciones) === firma(adiciones)
    );

  function mover(id, conPapa, adiciones, delta) {
    const linea = buscar(id, conPapa, adiciones);
    if (!linea) {
      if (delta > 0) carrito.push({ id, conPapa, adiciones, cantidad: 1 });
    } else {
      linea.cantidad += delta;
      if (linea.cantidad < 1) carrito = carrito.filter((l) => l !== linea);
    }
    guardar();
  }

  function pintarVar(el) {
    const n = buscar(el.dataset.id, el.dataset.papa === "1", adisElegidas(el))?.cantidad ?? 0;
    el.querySelector(".add").hidden = n > 0;
    el.querySelector(".paso").hidden = n === 0;
    el.querySelector("[data-n]").textContent = String(n);
  }

  function pintarBarra() {
    const barra = document.querySelector(".carrito");
    if (!barra) return;
    const items = carrito.reduce((s, l) => s + l.cantidad, 0);
    const total = carrito.reduce((s, l) => s + precioUnidad(l) * l.cantidad, 0);
    barra.hidden = items === 0;
    barra.querySelector("[data-items]").textContent = String(items);
    barra.querySelector("[data-total]").textContent =
      "$" + new Intl.NumberFormat("es-CO").format(total);
  }

  document.querySelectorAll(".var").forEach(pintarVar);
  pintarBarra();

  document.addEventListener("click", (e) => {
    const chip = e.target.closest(".adi");
    if (chip) {
      // Los extras eligen sobre qué versión del plato se actúa: al cambiarlos,
      // los contadores pasan a mostrar los de esa combinación.
      chip.setAttribute("aria-pressed", chip.getAttribute("aria-pressed") === "true" ? "false" : "true");
      chip.closest(".vars").querySelectorAll(".var").forEach(pintarVar);
      return;
    }

    const boton = e.target.closest("[data-accion]");
    if (!boton) return;
    const el = boton.closest(".var");
    if (!el) return;

    mover(
      el.dataset.id,
      el.dataset.papa === "1",
      adisElegidas(el),
      boton.dataset.accion === "mas" ? 1 : -1
    );
    pintarVar(el);
    pintarBarra();
  });

  // Resalta en la barra la categoría que se está mirando.
  const tabs = document.querySelectorAll(".cats a");
  const cats = document.querySelectorAll(".cat");
  if (tabs.length && cats.length) {
    const espia = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = e.target.id.replace("c-", "");
          tabs.forEach((t) => t.classList.toggle("is-active", t.getAttribute("href") === `#c-${id}`));
        });
      },
      { rootMargin: "-130px 0px -65% 0px" }
    );
    cats.forEach((c) => espia.observe(c));
  }
</script>
